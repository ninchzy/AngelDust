{
  "name": "angel-dust",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "node --env-file=.env --watch server/index.js",
    "db:setup": "node --env-file=.env server/setup-db.js",
    "photos": "node --env-file=.env scripts/import-photos.mjs",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "mysql2": "^3.24.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "vite": "^6.3.5"
  }
}
